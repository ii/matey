#!/usr/bin/env bash
# set -xe # Enable for debug
# Use IIMATEY_DIR if set, or default to $HOME/.config/iimatey
export IIMATEY_DIR=${IIMATEY_DIR:-$HOME/.config/iimatey}
mkdir -p $IIMATEY_DIR
# Logfiles collect both stderr and stdout from ttyd and tunnel
export TTYD_LOGFILE=$IIMATEY_DIR/ttyd.log
export TUNNEL_LOGFILE=$IIMATEY_DIR/tunnel.log

# Possibly presist this...
# https://www.man7.org/linux/man-pages/man8/wg.8.html#COMMANDS
# wg genkey :: Generates a random private key in base64 and prints it to standard output.
# You could save this to persist your url.
# Use IIMATEY_API_URL if set, or default to https://iimatey.sharing.io
export TUNNEL_API_URL=${IIMATEY_API_URL:-https://iimatey.sharing.io}

# We install to /usr/local/bin... but on OSX it's not in the path by default
export PATH=/usr/local/bin:$PATH

# Generate tunnel name - sanitize to meet requirements:
# - 3-32 characters, lowercase alphanumeric with hyphens
# - must start and end with alphanumeric
sanitize_name() {
  local name="$1"
  # Convert to lowercase, replace invalid chars with hyphens
  name=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-')
  # Remove leading/trailing hyphens and collapse multiple hyphens
  name=$(echo "$name" | sed 's/^-*//;s/-*$//;s/--*/-/g')
  # Truncate to 32 chars, ensuring we don't end with hyphen
  name="${name:0:32}"
  name=$(echo "$name" | sed 's/-*$//')
  # Ensure minimum 3 chars
  if [ ${#name} -lt 3 ]; then
    name="${name}000"
    name="${name:0:3}"
  fi
  echo "$name"
}

# Tunnel name: explicit only, never a guessable default. `iimatey start
# NAME` (positional) or IIMATEY_NAME (env var, takes priority) name it
# deliberately -> https://NAME.sharing.io. If NEITHER is given, TUNNEL_NAME
# stays empty and `start` won't pass -n to `tunnel` at all, so tunneld
# assigns its own random/unguessable hash URL instead. (Previously always
# defaulted to "<user>-<hostname>", e.g. "hh-nextral" — predictable by
# construction, not something you want unless you asked for a stable,
# nameable URL.)
if [ -n "$IIMATEY_NAME" ]; then
  TUNNEL_NAME=$(sanitize_name "$IIMATEY_NAME")
elif [ "${1:-}" = "start" ] && [ -n "${2:-}" ]; then
  TUNNEL_NAME=$(sanitize_name "$2")
else
  TUNNEL_NAME=""
fi
export TUNNEL_NAME

# Key per NAME, not one fixed key for everything. wgtunnel derives the
# tunnel's routable IP as a hash of its key and keeps a name's registration
# "warm" for a couple minutes after the last client using that key
# disconnects — even if the process died abruptly (a crash, a killed pid)
# with no chance to tell the server. A single shared key meant restarting
# under the SAME name right after a kill could 409 (a different-looking
# client racing the old registration's cooldown), found live. Keying the
# file to the name means the same name reconnects on the same identity
# (fine, expected), and switching names never fights an old registration.
#
# No name at all -> a fresh one-time key every run, so "no name" really
# means a random/unguessable URL each time, not a fixed key that just
# happens to have no name attached to it.
if [ -n "$TUNNEL_NAME" ]; then
  export TUNNEL_WIREGUARD_KEYFILE=${IIMATEY_DIR}/tunnel-key-${TUNNEL_NAME}
else
  export TUNNEL_WIREGUARD_KEYFILE=${IIMATEY_DIR}/tunnel-key-onetime-$$-$(date +%s%N 2>/dev/null || echo $RANDOM)
fi

# tmux session name iimatey creates/attaches to. Hardcoded "ii" collides
# with any other unrelated tmux session already using that name (found
# live: a multi-agent host with its own pre-existing "ii" session for
# other work) — every start/connect then fails at the tmux step, having
# already spawned ttyd+tunnel as orphans. Override with IIMATEY_SESSION.
export IIMATEY_SESSION=${IIMATEY_SESSION:-ii}

# Usage iimatey [status|start [NAME]|stop|connect|https://URL] # Default is status
ACTION=${1:-status}
case $ACTION in
  status)
    # List information about tmux
    if tmux has-session -t "$IIMATEY_SESSION" 2>/dev/null 1>/dev/null; then
      tmux list-sessions
      tmux has-session -t "$IIMATEY_SESSION"
      tmux list-windows -t "$IIMATEY_SESSION"
    else
      echo "No tmux sessions"
    fi
    # Display how to connect to ttyd
    if [[ -e $IIMATEY_DIR/ttyd.pid ]]; then
      ps -p $(cat $IIMATEY_DIR/ttyd.pid) 2>&1 >/dev/null &&
        echo Connect to ttyd locally via http://localhost:7681
    fi
    # Display how to connect to tunnel
    if [[ -e $IIMATEY_DIR/tunnel.pid ]]; then
      ps -p $(cat $IIMATEY_DIR/tunnel.pid) 2>&1 >/dev/null &&
        grep "You can now connect" $IIMATEY_DIR/tunnel.log
    fi
    # Display how to connect to tmux directly
    tmux has-session -t "$IIMATEY_SESSION" 2>/dev/null 1>/dev/null &&
      echo Connect to tmux locally via: &&
      echo tmux at -t "$IIMATEY_SESSION"
    if [ -n "$TUNNEL_NAME" ]; then
      echo "Tunnel name: $TUNNEL_NAME (set via IIMATEY_NAME env var or 'iimatey start $TUNNEL_NAME')"
    else
      echo "Tunnel name: (none — random/unguessable URL; name one with 'iimatey start NAME' or IIMATEY_NAME)"
    fi
    echo "Session name: $IIMATEY_SESSION (override with IIMATEY_SESSION env var)"
    echo 'USAGE: iimatey [status|start [NAME]|stop|connect|https://some-share-url]'
    ;;
  start)
    # TODO: nicer logic here to detect available port and start
    # ttyd support -p 0 (random port), but have not reliable way to grab it
    #export TTYD_PORT=${TTYD_PORT:12346}
    # Use port 7681 (ttyd default) to avoid conflict with tunneld on 12345
    ttyd --writable -p 7681 tmux attach -t "$IIMATEY_SESSION" 2>&1 >$TTYD_LOGFILE &
    echo $! >$IIMATEY_DIR/ttyd.pid
    echo ttyd logs are available in $TTYD_LOGFILE
    if [ -n "$TUNNEL_NAME" ]; then
      echo "Registering tunnel with name: $TUNNEL_NAME"
      tunnel -n "$TUNNEL_NAME" localhost:7681 2>&1 >$TUNNEL_LOGFILE &
    else
      echo "Registering tunnel with a random, unguessable URL (no name given — pass one: iimatey start NAME)"
      tunnel localhost:7681 2>&1 >$TUNNEL_LOGFILE &
    fi
    echo $! >$IIMATEY_DIR/tunnel.pid
    echo tunnel logs are available in $TUNNEL_LOGFILE
    sleep 1 # Would be good to just wait till URL is available
    export IIMATEY_URL=$(grep "You can now connect" $IIMATEY_DIR/tunnel.log | sed 'sX.*\(https://.*\)X\1X')
    if ! tmux has-session -t "$IIMATEY_SESSION" 2>/dev/null; then
      tmux new -e IIMATEY=true -s "$IIMATEY_SESSION" -P -F "$IIMATEY_URL" -n matey
      echo $! >$IIMATEY_DIR/tmux.pid
    else
      tmux attach -t "$IIMATEY_SESSION"
    fi
    ;;
  stop)
    # we won't stop tmux... let's leave it
    # kill, then ALWAYS clean up the pidfile — even if the process was
    # already dead (a prior crash, an earlier `stop`, a reboot since it
    # started). `kill && rm` left a stale pidfile behind whenever kill
    # failed, found live.
    if [[ -e $IIMATEY_DIR/ttyd.pid ]]; then
      kill $(cat $IIMATEY_DIR/ttyd.pid) 2>/dev/null
      rm -f $IIMATEY_DIR/ttyd.pid
    fi
    if [[ -e $IIMATEY_DIR/tunnel.pid ]]; then
      kill $(cat $IIMATEY_DIR/tunnel.pid) 2>/dev/null
      rm -f $IIMATEY_DIR/tunnel.pid
    fi
    ;;
  connect)
    # Create new, or connect to old (doesn't start ttyd or tunnel)
    if tmux has-session -t "$IIMATEY_SESSION" 2>/dev/null; then
      tmux attach -t "$IIMATEY_SESSION"
    else
      tmux new -e IIMATEY=true -s "$IIMATEY_SESSION"
      echo $! >$IIMATEY_DIR/tmux.pid
    fi
    ;;
  http://*|https://*)
    # Client mode: connect to a remote iimatey/ttyd share URL (yours or
    # someone else's) with a real local terminal instead of a browser.
    # ttyc speaks ttyd's websocket protocol directly (see depau/ttyc);
    # installed by iimatey-setup.sh alongside ttyd/tunnel.
    command -v ttyc >/dev/null 2>&1 || {
      echo "ERROR: ttyc not found — re-run iimatey-setup.sh to install it" >&2
      exit 1
    }
    exec ttyc -U "$ACTION"
    ;;
esac
