#!/usr/bin/env bash
# set -xe # Enable for debug
# Use IIMATEY_DIR if set, or default to $HOME/.config/iimatey
export IIMATEY_DIR=${IIMATEY_DIR:-$HOME/.config/iimatey}
mkdir -p $IIMATEY_DIR
# Logfiles collect both stderr and stdout from ttyd and tunnel
export TTYD_LOGFILE=$IIMATEY_DIR/ttyd.log
export TUNNEL_LOGFILE=$IIMATEY_DIR/tunnel.log

# Possibly presist this...
# https://www.man7.org/linux/man-pages/man8/wg.8.html#COMMANDS
# wg genkey :: Generates a random private key in base64 and prints it to standard output.
# You could save this to persist your url.
# Use IIMATEY_API_URL if set, or default to https://iimatey.sharing.io
export TUNNEL_API_URL=${IIMATEY_API_URL:-https://iimatey.sharing.io}

# We install to /usr/local/bin... but on OSX it's not in the path by default
export PATH=/usr/local/bin:$PATH

# Generate tunnel name - sanitize to meet requirements:
# - 3-32 characters, lowercase alphanumeric with hyphens
# - must start and end with alphanumeric
sanitize_name() {
  local name="$1"
  # Convert to lowercase, replace invalid chars with hyphens
  name=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-')
  # Remove leading/trailing hyphens and collapse multiple hyphens
  name=$(echo "$name" | sed 's/^-*//;s/-*$//;s/--*/-/g')
  # Truncate to 32 chars, ensuring we don't end with hyphen
  name="${name:0:32}"
  name=$(echo "$name" | sed 's/-*$//')
  # Ensure minimum 3 chars
  if [ ${#name} -lt 3 ]; then
    name="${name}000"
    name="${name:0:3}"
  fi
  echo "$name"
}

# Tunnel name: explicit only, never a guessable default. `iimatey start
# NAME` (positional) or IIMATEY_NAME (env var, takes priority) name it
# deliberately -> https://NAME.sharing.io. If NEITHER is given, TUNNEL_NAME
# stays empty and `start` won't pass -n to `tunnel` at all, so tunneld
# assigns its own random/unguessable hash URL instead. (Previously always
# defaulted to "<user>-<hostname>", e.g. "hh-nextral" — predictable by
# construction, not something you want unless you asked for a stable,
# nameable URL.)
if [ -n "$IIMATEY_NAME" ]; then
  TUNNEL_NAME=$(sanitize_name "$IIMATEY_NAME")
elif [ "${1:-}" = "start" ] && [ -n "${2:-}" ]; then
  TUNNEL_NAME=$(sanitize_name "$2")
else
  TUNNEL_NAME=""
fi
export TUNNEL_NAME

# Key per NAME, not one fixed key for everything. wgtunnel derives the
# tunnel's routable IP as a hash of its key and keeps a name's registration
# "warm" for a couple minutes after the last client using that key
# disconnects — even if the process died abruptly (a crash, a killed pid)
# with no chance to tell the server. A single shared key meant restarting
# under the SAME name right after a kill could 409 (a different-looking
# client racing the old registration's cooldown), found live. Keying the
# file to the name means the same name reconnects on the same identity
# (fine, expected), and switching names never fights an old registration.
#
# No name at all -> a fresh one-time key every run, so "no name" really
# means a random/unguessable URL each time, not a fixed key that just
# happens to have no name attached to it.
if [ -n "$TUNNEL_NAME" ]; then
  export TUNNEL_WIREGUARD_KEY_FILE=${IIMATEY_DIR}/tunnel-key-${TUNNEL_NAME}
else
  export TUNNEL_WIREGUARD_KEY_FILE=${IIMATEY_DIR}/tunnel-key-onetime-$$-$(date +%s%N 2>/dev/null || echo $RANDOM)
fi

# tmux session name iimatey creates/attaches to. Hardcoded "ii" collides
# with any other unrelated tmux session already using that name (found
# live: a multi-agent host with its own pre-existing "ii" session for
# other work) — every start/connect then fails at the tmux step, having
# already spawned ttyd+tunnel as orphans. Override with IIMATEY_SESSION.
export IIMATEY_SESSION=${IIMATEY_SESSION:-ii}

# Local ttyd port. The old hardcoded 7681 (ttyd's default) collides with any
# system-wide ttyd already on the box — found live: a root ttyd.service owned
# 7681, iimatey's own ttyd died at launch, and the tunnel happily published
# the ROOT login shell at the share URL. Override with TTYD_PORT; start also
# refuses to run if the port is already taken (see the start case).
export TTYD_PORT=${TTYD_PORT:-7681}

# Usage iimatey [status|start [NAME]|stop|connect|probe [URL]|https://URL] # Default is status
ACTION=${1:-status}
case $ACTION in
  status)
    # List information about tmux
    if tmux has-session -t "$IIMATEY_SESSION" 2>/dev/null 1>/dev/null; then
      tmux list-sessions
      tmux has-session -t "$IIMATEY_SESSION"
      tmux list-windows -t "$IIMATEY_SESSION"
    else
      echo "No tmux sessions"
    fi
    # Display how to connect to ttyd
    if [[ -e $IIMATEY_DIR/ttyd.pid ]]; then
      ps -p $(cat $IIMATEY_DIR/ttyd.pid) 2>&1 >/dev/null &&
        echo Connect to ttyd locally via http://localhost:$TTYD_PORT
    fi
    # Display how to connect to tunnel
    if [[ -e $IIMATEY_DIR/tunnel.pid ]]; then
      ps -p $(cat $IIMATEY_DIR/tunnel.pid) 2>&1 >/dev/null &&
        grep "You can now connect" $IIMATEY_DIR/tunnel.log
    fi
    # Display how to connect to tmux directly
    tmux has-session -t "$IIMATEY_SESSION" 2>/dev/null 1>/dev/null &&
      echo Connect to tmux locally via: &&
      echo tmux at -t "$IIMATEY_SESSION"
    if [ -n "$TUNNEL_NAME" ]; then
      echo "Tunnel name: $TUNNEL_NAME (set via IIMATEY_NAME env var or 'iimatey start $TUNNEL_NAME')"
    else
      echo "Tunnel name: (none — random/unguessable URL; name one with 'iimatey start NAME' or IIMATEY_NAME)"
    fi
    echo "Session name: $IIMATEY_SESSION (override with IIMATEY_SESSION env var)"
    echo 'USAGE: iimatey [status|start [NAME]|stop|connect|probe [URL]|share TARGET [NAME] [--rw]|unshare NAME|shares|https://some-share-url]'
    ;;
  start)
    # Refuse to start if something else already owns $TTYD_PORT: our ttyd
    # would die at bind, and the tunnel would then publish WHATEVER is on
    # that port at the share URL (on one box: a root login ttyd). bash's
    # /dev/tcp keeps this dependency-free — no lsof/ss needed.
    if (exec 3<>/dev/tcp/127.0.0.1/$TTYD_PORT) 2>/dev/null; then
      echo "ERROR: port $TTYD_PORT is already in use — refusing to start, we will not tunnel a service we don't own." >&2
      echo "       Set TTYD_PORT to a free port (e.g. TTYD_PORT=7682 iimatey start NAME) or stop the other service." >&2
      exit 1
    fi
    # NOTE: >$LOG 2>&1, not 2>&1 >$LOG — the latter sends stderr to the
    # terminal and leaves the logfile empty of errors, found live while
    # diagnosing exactly the port collision above.
    ttyd --writable -p $TTYD_PORT tmux attach -t "$IIMATEY_SESSION" >$TTYD_LOGFILE 2>&1 &
    echo $! >$IIMATEY_DIR/ttyd.pid
    echo ttyd logs are available in $TTYD_LOGFILE
    if [ -n "$TUNNEL_NAME" ]; then
      echo "Registering tunnel with name: $TUNNEL_NAME"
      tunnel -n "$TUNNEL_NAME" localhost:$TTYD_PORT >$TUNNEL_LOGFILE 2>&1 &
    else
      echo "Registering tunnel with a random, unguessable URL (no name given — pass one: iimatey start NAME)"
      tunnel localhost:$TTYD_PORT >$TUNNEL_LOGFILE 2>&1 &
    fi
    echo $! >$IIMATEY_DIR/tunnel.pid
    echo tunnel logs are available in $TUNNEL_LOGFILE
    sleep 1 # Would be good to just wait till URL is available
    export IIMATEY_URL=$(grep "You can now connect" $IIMATEY_DIR/tunnel.log | sed 'sX.*\(https://.*\)X\1X')
    if ! tmux has-session -t "$IIMATEY_SESSION" 2>/dev/null; then
      # (No tmux.pid: tmux new runs in the FOREGROUND, so the old
      # `echo $! > tmux.pid` here actually recorded the tunnel's pid — the
      # last background job — and nothing ever read tmux.pid anyway.)
      tmux new -e IIMATEY=true -s "$IIMATEY_SESSION" -P -F "$IIMATEY_URL" -n matey
    else
      tmux attach -t "$IIMATEY_SESSION"
    fi
    ;;
  stop)
    # we won't stop tmux... let's leave it
    # kill, then ALWAYS clean up the pidfile — even if the process was
    # already dead (a prior crash, an earlier `stop`, a reboot since it
    # started). `kill && rm` left a stale pidfile behind whenever kill
    # failed, found live.
    if [[ -e $IIMATEY_DIR/ttyd.pid ]]; then
      kill $(cat $IIMATEY_DIR/ttyd.pid) 2>/dev/null
      rm -f $IIMATEY_DIR/ttyd.pid
    fi
    if [[ -e $IIMATEY_DIR/tunnel.pid ]]; then
      kill $(cat $IIMATEY_DIR/tunnel.pid) 2>/dev/null
      rm -f $IIMATEY_DIR/tunnel.pid
    fi
    # One-time (unnamed) keys are single-use by design; sweep them so they
    # don't accumulate now that TUNNEL_WIREGUARD_KEY_FILE is actually honored.
    rm -f $IIMATEY_DIR/tunnel-key-onetime-*
    # Sweep any historical tmux.pid too: old versions wrote the wrong pid
    # here (the tunnel's, via `echo $!` after a foreground tmux) and nothing
    # ever read it.
    rm -f $IIMATEY_DIR/tmux.pid
    ;;
  connect)
    # Create new, or connect to old (doesn't start ttyd or tunnel)
    if tmux has-session -t "$IIMATEY_SESSION" 2>/dev/null; then
      tmux attach -t "$IIMATEY_SESSION"
    else
      tmux new -e IIMATEY=true -s "$IIMATEY_SESSION"
    fi
    ;;
  share|single)
    # iimatey share TARGET [NAME] [--rw] [--no-tunnel] [--port N]
    # ("single" is an alias: share a SINGLE window/role, never the stack.)
    #
    # Share ONE tmux window (a "role"), not a whole session. Builds a
    # dedicated viewer session with the target window LINKED in, so
    # viewers see exactly that role and nothing else:
    #   - prefix/prefix2 set to None in the viewer session: viewers cannot
    #     invoke ANY tmux command (no new-window shell escape, no window
    #     switching, no kill) — raw keys flow to the shared pane only.
    #   - READ-ONLY by default, enforced server-side (ttyd without
    #     --writable). Pass --rw for a writable share.
    #   - The shared window's size is frozen (window-size manual) for the
    #     duration so a small viewer can't shrink the real display;
    #     restored on unshare.
    # TARGET may be a window (stage:5) or pane (stage:5.0) — panes share
    # their containing window. NAME defaults to the window's name.
    TARGET="${2:-}"
    [ -n "$TARGET" ] || { echo "USAGE: iimatey share TARGET [NAME] [--rw] [--no-tunnel] [--port N]" >&2; exit 1; }
    tmux has-session -t "${TARGET%%:*}" 2>/dev/null || { echo "ERROR: no such tmux target: $TARGET" >&2; exit 1; }
    WIN=$(tmux display -p -t "$TARGET" '#{session_name}:#{window_index}') || exit 1
    shift 2
    SHARE_NAME="" RW="" DO_TUNNEL=1 SHARE_PORT=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --rw) RW=1 ;;
        --no-tunnel) DO_TUNNEL="" ;;
        --port) SHARE_PORT="$2"; shift ;;
        *) SHARE_NAME="$1" ;;
      esac
      shift
    done
    [ -n "$SHARE_NAME" ] || SHARE_NAME=$(tmux display -p -t "$WIN" '#{window_name}')
    SHARE_NAME=$(sanitize_name "$SHARE_NAME")
    SNAME="matey-share-$SHARE_NAME"
    SHARE_DIR=$IIMATEY_DIR/share-$SHARE_NAME
    if tmux has-session -t "$SNAME" 2>/dev/null; then
      echo "ERROR: '$SHARE_NAME' is already shared (iimatey unshare $SHARE_NAME first)" >&2
      exit 1
    fi
    mkdir -p "$SHARE_DIR"
    # Freeze geometry BEFORE any viewer can attach, remember prior value.
    tmux show -w -v -t "$WIN" window-size 2>/dev/null >"$SHARE_DIR/window-size.prev" || true
    tmux setw -t "$WIN" window-size manual
    echo "$WIN" >"$SHARE_DIR/window"
    W=$(tmux display -p -t "$WIN" '#{window_width}')
    H=$(tmux display -p -t "$WIN" '#{window_height}')
    tmux new-session -d -s "$SNAME" -x "$W" -y "$H"
    DUMMY=$(tmux display -p -t "$SNAME" '#{window_index}')
    tmux set -t "$SNAME" prefix None
    tmux set -t "$SNAME" prefix2 None
    tmux set -t "$SNAME" status off
    tmux link-window -s "$WIN" -t "$SNAME:9"
    tmux select-window -t "$SNAME:9"
    tmux kill-window -t "$SNAME:$DUMMY"
    # Pick a port: explicit, else first free from 7684 (main share is 7681).
    if [ -z "$SHARE_PORT" ]; then
      SHARE_PORT=7684
      while (exec 3<>/dev/tcp/127.0.0.1/$SHARE_PORT) 2>/dev/null; do
        SHARE_PORT=$((SHARE_PORT + 1))
      done
    fi
    echo "$SHARE_PORT" >"$SHARE_DIR/port"
    if [ -n "$RW" ]; then WOPT=--writable; MODE=WRITABLE; else WOPT=""; MODE=read-only; fi
    ttyd $WOPT -m "${IIMATEY_SHARE_MAX_CLIENTS:-10}" -p "$SHARE_PORT" tmux attach -t "$SNAME" >"$SHARE_DIR/ttyd.log" 2>&1 &
    echo $! >"$SHARE_DIR/ttyd.pid"
    echo "Sharing $WIN ($MODE) locally at http://localhost:$SHARE_PORT"
    if [ -n "$DO_TUNNEL" ]; then
      TUNNEL_WIREGUARD_KEY_FILE=$IIMATEY_DIR/tunnel-key-$SHARE_NAME \
        tunnel -n "$SHARE_NAME" localhost:"$SHARE_PORT" >"$SHARE_DIR/tunnel.log" 2>&1 &
      echo $! >"$SHARE_DIR/tunnel.pid"
      sleep 2
      grep "You can now connect" "$SHARE_DIR/tunnel.log" | tail -1
    fi
    echo "Stop with: iimatey unshare $SHARE_NAME"
    ;;
  unshare)
    SHARE_NAME=$(sanitize_name "${2:-}")
    SHARE_DIR=$IIMATEY_DIR/share-$SHARE_NAME
    [ -d "$SHARE_DIR" ] || { echo "ERROR: no share named '$SHARE_NAME' (looked in $SHARE_DIR)" >&2; exit 1; }
    for p in ttyd tunnel; do
      if [[ -e $SHARE_DIR/$p.pid ]]; then
        kill "$(cat "$SHARE_DIR/$p.pid")" 2>/dev/null
        rm -f "$SHARE_DIR/$p.pid"
      fi
    done
    # Killing the viewer session only UNLINKS the shared window — the real
    # window lives on in its home session.
    tmux kill-session -t "matey-share-$SHARE_NAME" 2>/dev/null
    if [[ -s $SHARE_DIR/window ]]; then
      WIN=$(cat "$SHARE_DIR/window")
      PREV=$(cat "$SHARE_DIR/window-size.prev" 2>/dev/null)
      if [ -n "$PREV" ]; then
        tmux setw -t "$WIN" window-size "$PREV" 2>/dev/null
      else
        tmux setw -u -t "$WIN" window-size 2>/dev/null
      fi
    fi
    rm -rf "$SHARE_DIR"
    echo "Unshared $SHARE_NAME"
    ;;
  shares)
    found=""
    for d in "$IIMATEY_DIR"/share-*/; do
      [ -d "$d" ] || continue
      found=1
      n=$(basename "$d"); n=${n#share-}
      alive=dead
      [ -e "$d/ttyd.pid" ] && kill -0 "$(cat "$d/ttyd.pid")" 2>/dev/null && alive=live
      url=$(grep -o 'https://[a-z0-9.-]*\.sharing\.io' "$d/tunnel.log" 2>/dev/null | tail -1)
      echo "$n: $alive window=$(cat "$d/window" 2>/dev/null) port=$(cat "$d/port" 2>/dev/null) ${url:-(no tunnel)}"
    done
    [ -n "$found" ] || echo "No active shares (iimatey share TARGET [NAME] to create one)"
    ;;
  probe)
    # Prove a share is up AND writable, end to end: speaks ttyd's websocket
    # protocol (stdlib python3), types one marker command into the shared
    # terminal, and checks the echo comes back. Defaults to the local ttyd;
    # pass a share URL to probe through the tunnel. Exists because a wedged
    # connection is indistinguishable from "read-only" in a client — this
    # answers which side is broken in ~3 seconds.
    command -v python3 >/dev/null 2>&1 || {
      echo "ERROR: probe needs python3 (stdlib only — no packages)" >&2
      exit 1
    }
    PROBE="$(dirname "$0")/iimatey-probe"
    [ -x "$PROBE" ] || PROBE=iimatey-probe
    exec "$PROBE" ${2:+"$2"}
    ;;
  http://*|https://*)
    # Client mode: connect to a remote iimatey/ttyd share URL (yours or
    # someone else's) with a real local terminal instead of a browser.
    # ttyc speaks ttyd's websocket protocol directly (see depau/ttyc);
    # installed by iimatey-setup.sh alongside ttyd/tunnel.
    command -v ttyc >/dev/null 2>&1 || {
      echo "ERROR: ttyc not found — re-run iimatey-setup.sh to install it" >&2
      exit 1
    }
    exec ttyc -U "$ACTION"
    ;;
esac
